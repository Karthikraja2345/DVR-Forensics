# Environment Configuration for SIH-26150 DVR/NVR Forensics Platform

ENVIRONMENT=development
PROJECT_NAME="SIH-26150 DVR/NVR Forensic Analysis Platform"
TOOL_VERSION="1.0.0-rc1"
API_V1_STR="/api/v1"

# Database Configuration (SQLite by default, PostgreSQL ready)
# Local SQLite: sqlite:///./forensics.db
# PostgreSQL: postgresql+psycopg2://forensic_user:forensic_pass@localhost:5432/dvr_forensics
DATABASE_URL=sqlite:///./forensics.db

# Storage Directories
EVIDENCE_STORAGE_PATH=./evidence_cases
FIXTURES_PATH=./forensic_fixtures
REPORTS_OUTPUT_PATH=./reports/generated

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Security & Forensics
HASH_ALGORITHMS=["md5","sha256"]
FORCE_READ_ONLY_ORIGINAL=true
STRICT_CHAIN_OF_CUSTODY=true
LOG_LEVEL=INFO
